root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{md,yml,yaml,json}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

# tools/progress.ps1 含中文标签，必须带 BOM：Windows PowerShell 5.1 会把无 BOM 的 .ps1 当 ANSI 解码
[*.ps1]
charset = utf-8-bom