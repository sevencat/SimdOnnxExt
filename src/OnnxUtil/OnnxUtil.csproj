<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OnnxUtil</AssemblyName>
    <RootNamespace>OnnxUtil</RootNamespace>
    <PackageId>OnnxUtil</PackageId>
    <Description>用 Sdcb.SimdOnnx 公共 API 把 YOLO / RF-DETR / SAM3 / OCR 包成一键调用的统一门面：模型族自动识别、CPU/Vulkan 后端选择、每族预处理与解码。</Description>
    <PackageTags>Sdcb;ONNX;SIMD;Vulkan;YOLO;RF-DETR;SAM3;OCR</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <!-- 引擎与 ImageFacade 的引用由 Directory.Build.props 统一挂载（本地源码优先，可切 nuget）。 -->
  <ItemGroup>
    <!-- 核心就带 JPEG/PNG 编解码：一键调用不该要求使用者再注册格式（纯托管，AOT 友好） -->
    <PackageReference Include="Sdcb.SimdCodecs.Jpeg" />
    <PackageReference Include="Sdcb.SimdCodecs.Png" />
  </ItemGroup>
  <ItemGroup>
    <!-- OCR 模型来源：模型包只提供 ONNX 流 + 字典，不含推理代码，和本地引擎工程不冲突 -->
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.TextLineOrientation" />
  </ItemGroup>
</Project>
